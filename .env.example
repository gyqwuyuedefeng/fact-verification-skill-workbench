# 比赛工作台 PostgreSQL：固定数据库 kjjr_inx_brain、schema test。
APP_DB_URL=jdbc:postgresql://127.0.0.1:45432/kjjr_inx_brain?currentSchema=test
APP_DB_USERNAME=<测试库账号>
APP_DB_PASSWORD=<测试库密码>

# MCP Server 只读访问证据快照表。
SNAPSHOT_DB_URL=jdbc:postgresql://127.0.0.1:45432/kjjr_inx_brain?currentSchema=test
SNAPSHOT_DB_USERNAME=<只读账号>
SNAPSHOT_DB_PASSWORD=<只读密码>

# metastart dev 环境同源 ES；WSL 中必须填写该三节点对应的受管 127.0.0.1 转发列表。
ES_ADDRESSES=<受管WSL转发地址列表>
ES_SCHEMA=http
ES_USERNAME=<ES只读账号>
ES_PASSWORD=<ES密码>

# FireLM 当前公司千问的 OpenAI-compatible 配置。
# 可直接填 FireLM 当前的完整 chat-completions URL；也支持服务根地址。
LOCAL_MODEL_URL=<FireLM现有模型地址>
LOCAL_MODEL_ENDPOINT_PATH=/v1/chat/completions
LOCAL_MODEL_ID=<模型ID>
LOCAL_MODEL_API_KEY=<可选密钥>

MCP_BASE_URL=http://127.0.0.1:19091
WORKBENCH_STORAGE_ROOT=data
EVALUATION_MANIFEST_PATH=evals/manifest.json
SKILL_SOURCE_ROOT=skills/company-material-fact-check
