{
  "name": "fact-verification-skill-workbench-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.20.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm-run-all type-check build-only",
    "build-only": "vite build",
    "type-check": "vue-tsc --build --force",
    "test:unit": "vitest run",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write src"
  },
  "dependencies": {
    "@vicons/ionicons5": "^0.13.0",
    "echarts": "^6.0.0",
    "naive-ui": "^2.42.0",
    "pinia": "^3.0.3",
    "vue": "^3.5.21",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@tsconfig/node20": "^20.1.6",
    "@types/node": "^22.18.3",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/tsconfig": "^0.8.1",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^9.35.0",
    "eslint-plugin-vue": "^10.4.0",
    "jiti": "^2.6.1",
    "jsdom": "^26.1.0",
    "npm-run-all2": "^8.0.4",
    "prettier": "^3.6.2",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.42.0",
    "vite": "^7.1.5",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.0.6"
  }
}
